<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 管理员角色 Mapper -->
<mapper namespace="com.hypers.account.mapper.AdminRoleMapper">

    <!-- 查询用户的角色编码列表 -->
    <select id="selectRolesByUserId" resultType="string">
        select role_code from account_admin_roles where user_id = #{userId}
    </select>

    <!-- 新增角色分配 -->
    <insert id="insert">
        insert into account_admin_roles (user_id, role_code) values (#{userId}, #{roleCode})
    </insert>

</mapper>
