<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hypers.account.mapper.AccountUserApplicationMapper">

    <resultMap id="applicationResultMap" type="com.hypers.account.app.AccountApplication">
        <id property="appCode" column="app_code"/>
        <result property="name" column="name"/>
        <result property="entryUrl" column="entry_url"/>
        <result property="ssoCallbackUrl" column="sso_callback_url"/>
        <result property="permissionIframeUrl" column="permission_iframe_url"/>
        <result property="notifyBaseUrl" column="notify_base_url"/>
        <result property="secret" column="secret"/>
        <result property="defaultTenantCode" column="default_tenant_code"/>
        <result property="status" column="status"/>
        <result property="secretVersion" column="secret_version"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert">
        insert into account_user_applications (user_id, app_code) values (#{userId}, #{appCode})
    </insert>

    <delete id="delete">
        delete from account_user_applications where user_id = #{userId} and app_code = #{appCode}
    </delete>

    <select id="countByUserAndApp" resultType="int">
        select count(*) from account_user_applications where user_id = #{userId} and app_code = #{appCode}
    </select>

    <select id="selectAuthorizedApplications" resultMap="applicationResultMap">
        select a.app_code, a.name, a.entry_url, a.sso_callback_url, a.permission_iframe_url,
               a.notify_base_url, a.secret, a.default_tenant_code, a.status, a.secret_version,
               a.created_by, a.updated_by, a.created_at, a.updated_at
        from account_applications a
        join account_user_applications ua on ua.app_code = a.app_code
        where ua.user_id = #{userId}
        order by a.app_code
    </select>

</mapper>
